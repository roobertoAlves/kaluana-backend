# Kaluana Backend Environment Template
# Copy this file to .env or use as a base for .env.dev, .env.homolog, .env.prod

# Spring Profiles
SPRING_PROFILES_ACTIVE=dev

# Database
DB_URL=jdbc:postgresql://db:5432/kaluana
DB_USER=developer-kaluana
DB_PASSWORD=your_password_here

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Security
JWT_SECRET=your_jwt_secret_at_least_32_chars_long
JWT_EXPIRATION_MINUTES=30

# App Settings
FRONTEND_ORIGIN=http://localhost:5173
PAIRING_CODE_EXPIRATION_MINUTES=15
RATE_LIMIT_MAX_ATTEMPTS=10
RATE_LIMIT_WINDOW_SECONDS=60
