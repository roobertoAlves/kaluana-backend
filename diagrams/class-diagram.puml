@startuml class-diagram
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype polyline
skinparam nodesep 35
skinparam ranksep 55
skinparam defaultFontSize 12
skinparam packageStyle rectangle
hide empty members
title Diagrama de classes do domínio (atributos de auditoria omitidos)

package "Conta e sessão" {
  class User {
    - id: UUID
    - name: String
    - email: String
    - hashPassword: String
    - role: UserRole
    - nickname: String
    - avatarColor: String
    - emailVerified: boolean
    + User(name, email, hashPassword, role)
    + updateProfile(name, nickname, avatarColor): void
    + markEmailVerified(): void
  }
  class RefreshToken {
    - id: UUID
    - tokenHash: String
    - expiresAt: OffsetDateTime
    - revokedAt: OffsetDateTime
    + isUsable(now): boolean
    + revoke(now): void
  }
  class EmailVerificationToken {
    - id: UUID
    - tokenHash: String
    - expiresAt: OffsetDateTime
    - usedAt: OffsetDateTime
    + isUsable(now): boolean
    + markUsed(now): void
  }
}

package "Registro e rotina" {
  class LifeEvent {
    - id: UUID
    - category: EventCategory
    - note: String
    - urgent: boolean
    - occurredAt: OffsetDateTime
    + LifeEvent(userId, category, note, urgent, occurredAt)
  }
  class Reminder {
    - id: UUID
    - title: String
    - time: LocalTime
    - leadMinutes: int
    - frequency: ReminderFrequency
    - insistence: ReminderInsistence
    - enabled: boolean
    + configure(title, time, leadMinutes, frequency, insistence, enabled): void
  }
  class CheckIn {
    - id: UUID
    - day: LocalDate
    - level: short
    + CheckIn(userId, day)
    + record(level): void
  }
  class TrustedContact {
    - id: UUID
    - name: String
    - method: ContactMethod
    - value: String
    + update(name, method, value): void
  }
}

package "Tarefas e foco" {
  class Task {
    - id: UUID
    - title: String
    - priority: TaskPriority
    - estimatedMinutes: Integer
    - dueDate: LocalDate
    - status: TaskStatus
    + describe(title, priority, estimatedMinutes, dueDate): void
    + markDone(done): void
    + reschedule(newDueDate): void
    + addStep(text): TaskStep
    + updateStep(stepId, text, done): void
    + removeStep(stepId): void
  }
  class TaskStep {
    - id: UUID
    - text: String
    - position: short
    - done: boolean
    ~ TaskStep(task, text, position)
  }
  class TimerSession {
    - id: UUID
    - task: String
    - plannedMinutes: int
    - stepsCount: short
    - water: boolean
    - sound: TimerSound
    - status: TimerSessionStatus
    + TimerSession(userId, taskId, task, plannedMinutes, stepsCount, water, sound, status, startedAt, finishedAt)
  }
  class AmbientSession {
    - id: UUID
    - mode: AmbientMode
    - sound: TimerSound
    - plannedMinutes: int
    - status: TimerSessionStatus
    + AmbientSession(userId, mode, sound, plannedMinutes, status, startedAt, finishedAt)
  }
}

package "Planejamento do dia" {
  class DayPlan {
    - id: UUID
    - planDate: LocalDate
    - windowEnd: LocalTime
    - source: Source
    - energyLevel: Integer
    + replace(plan, windowEnd, source, energyLevel, note): void
    + blocksAsPlanned(): List<Block>
  }
  class PlannedBlock <<embutido>> {
    - kind: BlockKind
    - taskId: UUID
    - title: String
    - startTime: LocalTime
    - endTime: LocalTime
  }
  class UnscheduledTask <<embutido>> {
    - taskId: UUID
    - title: String
    - minutes: int
  }
  class DayReview {
    - id: UUID
    - reviewDate: LocalDate
    - feeling: DayFeeling
    - movedTomorrow: int
    - unscheduled: int
    - completed: int
    + record(action: ReviewAction): void
    + describe(feeling): void
  }
}

package "Vínculo e consentimento" {
  class PairingCode {
    - id: UUID
    - code: String
    - expiresAt: OffsetDateTime
    - used: boolean
    + markAsUsed(): void
  }
  class ResponsibleLink {
    - id: UUID
    - relationship: LinkRelationship
    - shareEvents: boolean
    - shareCheckIns: boolean
    - shareUsage: boolean
    - shareTasks: boolean
    - shareReports: boolean
    + {static} withDefaults(responsibleId, primaryUserId, defaults): ResponsibleLink
    + updatePermissions(permissions): void
    + otherSideOf(userId): UUID
  }
  class AccessSettings {
    - shareEvents: boolean
    - shareCheckIns: boolean
    - shareUsage: boolean
    - shareReports: boolean
    + {static} nothingSharedFor(userId): AccessSettings
    + update(events, checkIns, usage, reports): void
  }
}

User "1" *-up- "0..*" RefreshToken
User "1" *-up- "0..*" EmailVerificationToken

User "1" -left- "0..*" LifeEvent
User "1" -left- "0..*" Reminder
User "1" -left- "0..*" CheckIn
User "1" -left- "0..*" TrustedContact
LifeEvent -[hidden]down- Reminder
Reminder -[hidden]down- CheckIn
CheckIn -[hidden]down- TrustedContact

User "1 (principal)" -down- "0..*" ResponsibleLink
User "1 (responsável)" -down- "0..*" ResponsibleLink
User "1" -down- "0..*" PairingCode
User "1" -down- "0..1" AccessSettings
PairingCode -[hidden]right- ResponsibleLink
ResponsibleLink ..> AccessSettings : usa o padrão

User "1" -right- "0..*" Task
Task "1" *-down- "0..*" TaskStep
User "1" -right- "0..*" TimerSession
TimerSession "0..*" -down-> "0..1" Task
User "1" -right- "0..*" AmbientSession

User "1" -down- "0..*" DayPlan
DayPlan "1" *-down- "0..*" PlannedBlock
DayPlan "1" *-down- "0..*" UnscheduledTask
User "1" -down- "0..*" DayReview

PlannedBlock ..> Task : referência sem FK
DayReview ..> Task : decide pendentes

@enduml
