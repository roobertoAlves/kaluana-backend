@startuml focus-session-state-diagram
skinparam shadowing false
skinparam defaultFontSize 13
title Estados da sessão de foco (RF9)

[*] --> EmAndamento : startTimer(tarefa, minutos,\netapas, som)

state "Em andamento" as EmAndamento : prazo guardado como horário absoluto\nsom ambiente tocando (se escolhido)
state "Pausada" as Pausada : tempo restante guardado\nsom pausado
state "Concluída" as Concluida : registra TimerSession(DONE)
state "Encerrada antes" as Encerrada : registra TimerSession(CANCELED)

EmAndamento --> Pausada : pauseTimer()
Pausada --> EmAndamento : resumeTimer()
EmAndamento --> EmAndamento : addMinute()
Pausada --> Pausada : addMinute()
EmAndamento --> Concluida : reevaluateTimer()\n[prazo venceu]
EmAndamento --> Encerrada : cancelTimer()
Pausada --> Encerrada : cancelTimer()

Concluida --> [*]
Encerrada --> [*]

@enduml
