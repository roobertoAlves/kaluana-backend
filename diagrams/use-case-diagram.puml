@startuml use-case-diagram
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam defaultFontSize 13
title Diagrama de casos de uso

actor "Usuário\n(pessoa com TDAH)" as Usuario
actor "Responsável ou\nprofissional" as Responsavel
actor "Assistente de IA\n(opcional)" as IA

rectangle "Kaluanã" {
  usecase "Criar conta e\nconfirmar e-mail (RF18)" as UC18

  package "Registro e rotina" {
    usecase "Registrar evento (RF1)" as UC1
    usecase "Configurar lembrete (RF2)" as UC2
    usecase "Preencher check-in (RF3)" as UC3
    usecase "Cadastrar contato\nde confiança (RF4)" as UC4
    usecase "Personalizar perfil (RF12)" as UC12
  }

  package "Tarefas e foco" {
    usecase "Gerenciar tarefas e\nmicroetapas (RF5)" as UC5
    usecase "Criar tarefa por frase (RF15)" as UC15
    usecase "Conduzir sessão de foco (RF9)" as UC9
    usecase "Relaxar ou dormir\ncom sons (RF16)" as UC16
  }

  package "Planejamento" {
    usecase "Planejar o dia (RF10)" as UC10
    usecase "Pedir sugestão ao\nassistente (RF11)" as UC11
    usecase "Replanejar o dia (RF14)" as UC14
    usecase "Revisar o fim do dia (RF17)" as UC17
    usecase "Seguir o guia de\nautorregulação (RF13)" as UC13
  }

  package "Vínculo e relatório" {
    usecase "Gerar código de\nemparelhamento (RF6)" as UC6
    usecase "Definir o que cada\npessoa pode ver (RF8)" as UC8
    usecase "Vincular conta\npelo código (RF6)" as UC6b
    usecase "Exportar relatório\nem PDF (RF7)" as UC7
    usecase "Ver quem acessou\nmeus dados (RF8)" as UC19
  }
}

Usuario -- UC18
Usuario -- UC1
Usuario -- UC2
Usuario -- UC3
Usuario -- UC4
Usuario -- UC12
Usuario -- UC5
Usuario -- UC9
Usuario -- UC16
Usuario -- UC10
Usuario -- UC17
Usuario -- UC13
Usuario -- UC6
Usuario -- UC8

UC6b -- Responsavel
UC7 -- Responsavel
UC11 -- IA

UC15 .> UC5 : <<extend>>
UC11 .up.> UC10 : <<extend>>
UC14 .> UC10 : <<extend>>
UC19 .> UC8 : <<extend>>

@enduml
