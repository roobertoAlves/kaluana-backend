@startuml architecture-diagram
skinparam shadowing false
skinparam defaultFontSize 13
skinparam componentStyle rectangle
left to right direction
title Arquitetura do sistema

package "Aplicativo (React Native + Expo)" {
  [Telas e navegação] as Telas
  [Hooks de dados\n(cache em AsyncStorage)] as Hooks
  [Cliente HTTP único (axios)\nendereço da API automático] as Http
  [Notificações locais\n(expo-notifications)] as Notif
  [Sons e sessão de foco\n(expo-audio)] as Som
  [PDF do relatório\n(expo-print)] as Pdf
}

node "Produção" {
  [Caddy\n(HTTPS automático)] as Caddy
}

package "API (Spring Boot)" {
  [Filtro de limite\nde requisições] as Limite
  [Filtro de\nautenticação JWT] as Jwt
  [Controladores REST] as Ctrl
  [Serviços\n(regras de negócio)] as Serv
  [Repositórios JPA\n(filtrados pelo dono)] as Repo
  [Adaptador do\nassistente de IA] as Adapt
}

database "PostgreSQL\n(Flyway V1 a V16)" as Pg
database "Redis\n(contadores de limite)" as Redis
cloud "Serviço de IA opcional\n(Ollama ou compatível)" as IA
cloud "Servidor SMTP\n(Mailpit ou Gmail)" as Smtp

Telas --> Hooks
Hooks --> Http
Telas --> Notif
Telas --> Som
Telas --> Pdf
Http --> Caddy : HTTPS
Caddy --> Limite
Limite --> Jwt
Jwt --> Ctrl
Ctrl --> Serv
Serv --> Repo
Serv --> Adapt
Serv --> Smtp : e-mail de confirmação
Repo --> Pg
Limite --> Redis
Adapt ..> IA : somente se ligado

@enduml
